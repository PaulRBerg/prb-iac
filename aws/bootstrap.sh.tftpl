#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

export DEBIAN_FRONTEND=noninteractive
export GITHUB_TOKEN='${github_token}'

# --- Minimal prereqs for bootstrap ---
apt-get update -y
apt-get install -y curl git

# --- Clone dotfiles and hand off to bootstrap ---
sudo -u ubuntu git clone \
  "https://github.com/PaulRBerg/dotfiles.git" \
  /home/ubuntu/.local/share/chezmoi

cd /home/ubuntu/.local/share/chezmoi
SUDO_USER=ubuntu bash bootstrap_ubuntu.sh

echo ">>> Setup complete at $(date)"
