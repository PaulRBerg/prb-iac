#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

export DEBIAN_FRONTEND=noninteractive

GITHUB_TOKEN='${github_token}'
echo ">>> System packages"
apt-get update -y
apt-get upgrade -y
apt-get install -y \
  build-essential curl git jq unzip wget \
  software-properties-common apt-transport-https

# --- Git credentials (stored so 'git clone/push' just works) ---
echo ">>> Configuring git credentials"
sudo -u ubuntu git config --global credential.helper store
echo "https://PaulRBerg:$GITHUB_TOKEN@github.com" > /home/ubuntu/.git-credentials
chown ubuntu:ubuntu /home/ubuntu/.git-credentials
chmod 600 /home/ubuntu/.git-credentials

# --- Persist env vars ---
echo ">>> Setting environment variables"
cat >> /home/ubuntu/.bashrc <<'ENVEOF'

# prb-agents managed
export GITHUB_TOKEN='${github_token}'
ENVEOF

# --- chezmoi + dotfiles ---
echo ">>> Installing chezmoi"
sudo -u ubuntu mkdir -p /home/ubuntu/.local/bin
curl -fsLS get.chezmoi.io | sudo -u ubuntu sh -s -- -b /home/ubuntu/.local/bin

echo ">>> Cloning dotfiles"
sudo -u ubuntu mkdir -p /home/ubuntu/.local/share
sudo -u ubuntu git clone \
  "https://PaulRBerg:$GITHUB_TOKEN@github.com/PaulRBerg/dotfiles.git" \
  /home/ubuntu/.local/share/chezmoi

echo ">>> Running bootstrap_ubuntu.sh"
cd /home/ubuntu/.local/share/chezmoi
sudo -u ubuntu bash bootstrap_ubuntu.sh

echo ">>> Setup complete at $(date)"
